  "decisions": [
    {
      "id": "D-01",
      "topic": "procesni model",
      "decision": "M0 je knihovna v jednom procesu, pripravena na rozdeleni. Zustava knihovnou i pote, co cast pobezi jako sluzba - sluzba je zpusob nasazeni, ne zpusob psani. Kazdy blok musi jit pouzit sam, bez serveru.",
      "why": "Nejrychlejsi cesta k funkcnimu hello-app, a citelnost i blokova stavba se z ni neztrati. Rozhodl vlastnik projektu.",
      "docs": "architektura-navrh.md par. 12.1",
      "refs": [
        "Q-01"
      ],
      "implemented_in": "python/pyproject.toml, python/viewbase/ - knihovna, core bezi bez serveru"
    },
    {
      "id": "D-02",
      "topic": "rozvrzeni repa",
      "decision": "Jeden strom: core/ runtime/ transport/ providers/ types/ uvnitr python/viewbase/, frontend/ zvlast, surfaces/ zanika. Typ okna je jedna slozka uvnitr balicku.",
      "why": "Publikovany typ treti strany ma mit stejny tvar jako vestaveny - privilegovana cesta pro vestavene je chyba 3.4 z vb2.",
      "docs": "architektura-navrh.md par. 11, typy-oken.md par. 5",
      "refs": [
        "Q-02",
        "F-01"
      ],
      "implemented_in": "python/viewbase/core/ zalozeno; runtime/transport/providers/types zatim ne"
    },
    {
      "id": "D-03",
      "topic": "publikum zpravy",
      "decision": "Audience je vzdy POZDNE vazana a ma jen tvary Ref(address, verb), Session(sid), And(). Zadny tvar se zmrazenou mnozinou principalu neexistuje. Vysilaci smycka dostane jednu funkci resolve(address) -> Acl.",
      "why": "Zmrazene publikum doruci deltu i po odebrani prav. Kdyz ten tvar neexistuje, nejde pouzit omylem.",
      "docs": "architektura-navrh.md par. 3",
      "refs": [
        "Q-03",
        "F-05"
      ],
      "implemented_in": "python/viewbase/core/audience.py + python/tests/test_audience.py"
    },
    {
      "id": "D-04",
      "topic": "obsah okna",
      "decision": "content ma tri hodnoty: shared (model na klic screen+window, publikum = ACL okna), per-session (model na klic screen+window+session, publikum = ta relace), instance (model na instanci, publikum = VLASTNI ACL objektu).",
      "why": "Dve hodnoty nestacily na tri ruzne veci; log je instance-wide a nesmi dedit prava od plochy, kde se zobrazuje.",
      "docs": "typy-oken.md par. 2",
      "refs": [
        "Q-04",
        "F-04"
      ],
      "implemented_in": "zatim ne - patri do runtime (model na klic screen/window/session)"
    },
    {
      "id": "D-05",
      "topic": "rozsah M0",
      "decision": "M0 podle navrhu programatora vcetne typu log. Navic: Caller existuje uz v M0; akceptacni test 'anonym na verejne plose nedostane zaznam z logu'.",
      "why": "Log si vynuti publikum a vlastni ACL v nejlevnejsim okamziku. Caller az pozdeji by znamenal druhou vetev ve vynucovacim kodu.",
      "docs": "typy-oken.md par. 9",
      "refs": [
        "Q-05"
      ],
      "implemented_in": null
    },
    {
      "id": "D-06",
      "topic": "registr udalosti",
      "decision": "Needs = INSTANCE | SCREEN | SEE | WRITE (zadne NONE, zadne USE). Krok navic je druha nezavisla osa: step_up = REQUIRED (vychozi) | EXEMPT; EXEMPT ma jedine window_unlock.",
      "why": "Hodnota, ktera vypina kontrolu, nema v enumu co delat (chyba 3.2). Deklarovana vyjimka se da otestovat, vyjimka v komentari zetli.",
      "docs": "architektura-navrh.md par. 5",
      "refs": [
        "Q-06"
      ],
      "implemented_in": "zatim ne - patri do runtime/events.py, zacnu podle B-06 testem registru"
    },
    {
      "id": "D-07",
      "topic": "jazyk",
      "decision": "Identifikatory a vse strojove anglicky; docstringy a komentare cesky; audit anglicky sloupcovy; texty pro divaka anglicky, ale ze serveru jako klic + parametry, ne hotova veta.",
      "why": "Prejmenovavat pozdeji je pruchod celym repem a past je v retezcich (parametry cest, klice payloadu).",
      "docs": "architektura-navrh.md par. 12.3, glosar.md",
      "refs": [
        "Q-07"
      ],
      "implemented_in": "cely core: identifikatory anglicky, docstringy cesky"
    },
    {
      "id": "D-08",
      "topic": "frontend",
      "decision": "Vanilla JS + Vite, bez TypeScriptu. Schema je jedina pravda ZA BEHU: validace na obou stranach a jedna sada fixtur, kterou prochazi server i klient.",
      "why": "Rozhodl vlastnik projektu. Bez fixtur a validace by se strany rozesly - to je presne to, cemu mel TS zabranit.",
      "docs": "architektura-navrh.md par. 12.4",
      "refs": [
        "Q-08"
      ],
      "implemented_in": null
    },
    {
      "id": "D-09",
      "topic": "distribuce",
      "decision": "Bundle je v gitu (pip install git+... bez Node). Podminka: static/BUNDLE.sha256 s otiskem zdroju frontendu + test, ktery ho prepocita. Kontrola vznika DRIV nez prvni bundle.",
      "why": "Zamer je knihovna vlozitelna do ciziho projektu. Bez kontroly se vrati chyba 3.13 (nasazeny stary bundle).",
      "docs": "architektura-navrh.md par. 12.4",
      "refs": [
        "Q-09"
      ],
      "implemented_in": null
    },
    {
      "id": "D-10",
      "topic": "Caller",
      "decision": "Caller(principals, session, correlation, origin, remote). Do apky jde jen subject_id + correlation + capabilities. correlation = HMAC(tajemstvi instance, address+session), stabilni po dobu relace. origin='internal' pro uzivatelsky kod knihovny: NEPROCHAZI autorizaci, ale publikum uvest musi.",
      "why": "Session id je prihlasovaci udaj a do apky nepatri (review, vyhrada 2). Jeden typ volajiciho zabrani druhe vetvi ve vynucovacim kodu.",
      "docs": "architektura-navrh.md par. 6",
      "refs": [
        "Q-10"
      ],
      "implemented_in": "python/viewbase/core/identity.py - Caller, Origin (viz F-08)"
    },
    {
      "id": "D-11",
      "topic": "identity v M0",
      "decision": "Knihovna nezaklada identity z aplikacniho kodu. V M0 existuje minimalni 'python -m viewbase.admin adduser' (uzivatel, tajemstvi, QR); plne rozhrani spravce az v M1.",
      "why": "TOTP tajemstvi se rukou nenapise - bez teto cesty se do instance neda prihlasit vubec.",
      "docs": "architektura-navrh.md par. 12.2",
      "refs": [
        "Q-12"
      ],
      "implemented_in": null
    },
    {
      "id": "D-12",
      "topic": "formality",
      "decision": "Balicek 'viewbase', import 'import viewbase as vb'. Licence Apache-2.0 (LICENSE v repu). .statefile patri do gitu.",
      "why": "Trojka je iterace projektu, ne jmeno knihovny. Licenci rozhodl vlastnik.",
      "docs": "LICENSE",
      "refs": [
        "Q-14"
      ],
      "implemented_in": "python/pyproject.toml - balicek 'viewbase', licence Apache-2.0"
    }
