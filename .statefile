    {
      "id": "D-21",
      "topic": "jmeno kroku navic",
      "decision": "Verejna vlastnost okna se jmenuje window.access.require_authentication. Vnitrni osa registrace udalosti zustava step_up.",
      "why": "Rozhodl vlastnik projektu. 'step_up' je zargon a v kodu aplikace nikomu nic nerekne; verejny povrch se pojmenovava pro toho, kdo ho cte poprve. Koncept ('krok navic') a volani nemusi mit stejne jmeno.",
      "docs": "architektura-navrh.md par. 4b, glosar.md",
